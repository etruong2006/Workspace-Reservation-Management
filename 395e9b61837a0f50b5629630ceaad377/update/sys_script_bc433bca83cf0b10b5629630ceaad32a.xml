        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {
    var status = current.reservation_status.toString();
    var workspace = new GlideRecord('x_1209398_wrm_workspace_options');
    if (!workspace.get(current.workspace)) {
        gs.warn('Workspace Sync: could not find workspace ' + current.workspace);
        return;
    }
    if (status == 'pending_check_in' || status == 'checked_in') {
        workspace.status = 'unavailable';
    } else if (status == 'checked_out' || status == 'no_show' || status == 'cancelled') {
        workspace.status = 'available';
    }
    workspace.update();
})(current, previous);]]></script>
