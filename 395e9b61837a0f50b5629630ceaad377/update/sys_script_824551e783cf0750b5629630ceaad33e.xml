        <script><![CDATA[(function executeRule(current, previous) {

    // Update the current Workspace Maintenance record
    current.status = 'available';

    // Update the related Workspace Option record
    if (current.workspace) {

        var workspaceGR = new GlideRecord('x_1209398_wrm_workspace_options');

        if (workspaceGR.get(current.workspace.toString())) {

            workspaceGR.status = 'available';

            // If you also have a Workspace Status field
            workspaceGR.workspace_status = 'available';

            workspaceGR.update();
        }
    }

})(current, previous);]]></script>
