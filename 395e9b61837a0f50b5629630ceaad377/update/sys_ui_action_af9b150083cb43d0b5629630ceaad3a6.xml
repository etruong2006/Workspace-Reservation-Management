        <name>Need Maintenance</name>
        <onclick/>
        <order>400</order>
        <script><![CDATA[var maint = new GlideRecord('x_1209398_wrm_workspace_maintenance');
maint.initialize();

maint.ticket_status = 'open';
maint.status = 'under_maintenance';
maint.date_reported = new GlideDateTime();
maint.reservation = current.sys_id;
maint.workspace = current.workspace;
maint.issue_description = current.maintenance_issue;

// Set Assignment Group
var grp = new GlideRecord('sys_user_group');
grp.addQuery('name', 'Workspace Maintenance Team');
grp.query();
if (grp.next()) {
    maint.assignment_group = grp.sys_id;
}

maint.insert();

action.setRedirectURL(current);]]></script>
