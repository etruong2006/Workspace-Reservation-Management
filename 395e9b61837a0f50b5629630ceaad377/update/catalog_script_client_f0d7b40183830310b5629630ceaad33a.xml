        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || !newValue) {
        return;
    }

    var start = g_form.getValue('start_date_time');

    if (!start) {
        return;
    }

    var startDT = new Date(start);
    var endDT = new Date(newValue);

    if (endDT < startDT) {
        g_form.addErrorMessage('End date/time should not be before the Start date/time');
        g_form.clearValue('end_date_time');
    }
}]]></script>
